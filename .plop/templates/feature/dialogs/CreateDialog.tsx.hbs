import { Create{{pascalCase name}}Form } from "../components/Create{{pascalCase name}}Form";
import { BaseFormDialog } from "@/components/custom-ui/dialog/BaseFormDialog";
import type { DialogProps } from "@/lib/dialog-registry";
import { useTranslation } from "react-i18next";
import { useCreate{{pascalCase name}} } from "../hooks/use{{pascalCase name}}s";

export function Create{{pascalCase name}}Dialog({ open, onOpenChange }: DialogProps<undefined>) {
    const { t } = useTranslation("{{camelCase name}}s");
    const create{{pascalCase name}} = useCreate{{pascalCase name}}();
