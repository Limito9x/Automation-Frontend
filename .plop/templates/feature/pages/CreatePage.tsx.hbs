import { useNavigate } from "@tanstack/react-router";
import { useTranslation } from "react-i18next";
import { FormPageShell } from "@/components/layout/FormPageShell";
import { Create{{pascalCase name}}Form } from "../components/Create{{pascalCase name}}Form";
import { useCreate{{pascalCase name}} } from "../hooks/use{{pascalCase name}}s";
import type { Create{{pascalCase name}}Output } from "../schemas/create{{pascalCase name}}Schema";

export function Create{{pascalCase name}}Page() {
    const { t } = useTranslation("{{camelCase name}}");
    const navigate = useNavigate();
    const { mutate, isPending } = useCreate{{pascalCase name}}();

    const handleSubmit = (data: Create{{pascalCase name}}Output) => {
