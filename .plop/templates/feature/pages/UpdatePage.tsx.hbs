import { useNavigate, useParams } from "@tanstack/react-router";
import { useTranslation } from "react-i18next";
import { FormPageShell } from "@/components/layout/FormPageShell";
import { Update{{pascalCase name}}Form } from "../components/Update{{pascalCase name}}Form";
import { useUpdate{{pascalCase name}} } from "../hooks/use{{pascalCase name}}s";
import type { Update{{pascalCase name}}Values } from "../schemas/update{{pascalCase name}}Schema";

export function Update{{pascalCase name}}Page() {
    const { t } = useTranslation("{{camelCase name}}");
    const navigate = useNavigate();
    const { id } = useParams({ strict: false }) as { id: string };

    const { mutate, isPending } = useUpdate{{pascalCase name}}();

    const handleSubmit = (data: Update{{pascalCase name}}Values) => {
        mutate(
            { id, data },
            {
                onSuccess: () => navigate({ to: "/{{kebabCase name}}s/$id", params: { id } }),
            }
        );
    };

    return (
        <FormPageShell
            title={t("actions.update", { defaultValue: "Edit {{pascalCase name}}" })}
            description={t("update.description", { defaultValue: "Modify {{camelCase name}} information." })}
            formId={`update-{{kebabCase name}}-form-${id}`}
            isPending={isPending}
            submitLabel={t("common:saveChanges", { defaultValue: "Save Changes" })}
            onCancel={() => navigate({ to: "/{{kebabCase name}}s/$id", params: { id } })}
            cancelLabel={t("common:cancel", { defaultValue: "Cancel" })}
        >
            <Update{{pascalCase name}}Form id={id} onSubmit={handleSubmit} />
        </FormPageShell>
    );
}
